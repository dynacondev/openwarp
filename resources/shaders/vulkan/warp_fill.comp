/*
 * Openwarp Vulkan compute warp, pass 3 (hole fill).
 *
 * Part of the Openwarp project, NCSA licensed (see LICENSE).
 *
 * Black-hole fill only: valid pull pixels (alpha >= eps) are
 * un-premultiplied, holes keep the pull result (black). The fillMode
 * push constant is the switch point for future fill methods (0 =
 * black; unknown modes fall back to 0 and never produce garbage).
 */

#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8) uniform image2D dstImg;
// Reserved for future depth-aware fills; unused by the black-hole pass
// but kept so the set layout stays stable when fills land.
layout(set = 0, binding = 1, r32ui) uniform uimage2D splatDepth;

layout(push_constant) uniform Push
{
	int fillMode; // 0 = black holes (only implemented mode)
} pc;

#define VALID_EPS (0.5 / 255.0)

void main()
{
	ivec2 xy = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(dstImg);
	if (xy.x >= size.x || xy.y >= size.y)
		return;
	vec4 v = imageLoad(dstImg, xy);
	if (v.a >= VALID_EPS) {
		imageStore(dstImg, xy, vec4(v.rgb / v.a, 1.0));
		return;
	}
	// Hole: leave black regardless of fillMode (future fills branch here).
	imageStore(dstImg, xy, vec4(0.0));
}
