/*
 * Openwarp Vulkan compute warp, pass 3 (hole fill).
 *
 * Part of the Openwarp project, NCSA licensed (see LICENSE).
 *
 * Mode 0 (black): valid pull pixels (alpha >= eps) are
 * un-premultiplied, holes keep the pull result (black).
 * Mode 1 (JFA background blur): holes look up their nearest
 * background seed from the JFA pass (warp_jfa_init/flood) and take a
 * full-res 5x5 validity-weighted average around the donor, rejecting
 * foreground-side taps by depth. Isotropic blur (never a single-texel
 * smear), full-res taps (no coarse-mip blocks), O(log N) flood cost
 * independent of hole width. Unknown modes fall back to 0 and never
 * produce garbage.
 *
 * Double-buffered: reads pull output from srcImg, writes to dstImg
 * (different images). Same-dispatch neighbor reads would otherwise race
 * hole-vs-hole fills (undefined by the Vulkan memory model).
 */

#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// Pull output (read-only stable snapshot for this dispatch).
layout(set = 0, binding = 0, rgba8) uniform readonly image2D srcImg;
// Foreground/background depth plane from the splat pass; mode 1 gates
// blur taps against the donor depth so foreground never leaks in.
// Keep DEPTH_TOL in sync with warp_jfa_init.comp (same value, seed
// classification vs gather gating).
layout(set = 0, binding = 1, r32ui) uniform readonly uimage2D splatDepth;
// JFA result: packed (x << 16) | y background donor per pixel,
// PACK_EMPTY when no background seed reached (<65536px axes, always
// true within Vulkan maxImageDimension2D). Unused by mode 0 but kept
// bound so the set layout stays stable.
layout(set = 0, binding = 2, r32ui) uniform readonly uimage2D jfaSeed;
// Fill output (write-only, distinct image from srcImg).
layout(set = 0, binding = 3, rgba8) uniform writeonly image2D dstImg;

layout(push_constant) uniform Push
{
	int fillMode; // 0 = black holes, 1 = JFA background blur
} pc;

#define VALID_EPS (0.5 / 255.0)
#define SPLAT_EMPTY 0xffffffffu
#define PACK_EMPTY 0xffffffffu
#define DEPTH_SCALE 16777215.0
// Foreground rejection width, nonlinear 0..1 depth units: taps this
// much shallower than the donor fade out. Far-plane slopes vary slowly
// in nonlinear space, so 0.02 keeps genuine background while killing
// the occluder.
#define DEPTH_TOL 0.02
// Dilation color gate (straight-rgb, 0..1): a hole-adjacent valid pixel
// is refilled only when it differs from a valid neighbor by more than
// this. Fringe/overshoot (~+0.13 in the flat-100 rig) trips it;
// minification cracks and screen borders (identical neighbors) do not.
#define DILATE_COLOR_TOL (8.0 / 255.0)

void main()
{
	ivec2 xy = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(srcImg);
	if (xy.x >= size.x || xy.y >= size.y)
		return;
	vec4 v = imageLoad(srcImg, xy);
	bool hole = (v.a < VALID_EPS);
	// Dilation runs only when filling (mode 1): mode 0 stays the pure
	// pull mask for honest A/B and diagnosis.
	// Hole dilation: valid pixels adjacent to holes are reclassified
	// as holes when they disagree in color with their valid neighbors.
	// Point splats overshoot foreground by ~1px into the disocclusion
	// (falsely-valid strip) and bilinear pull tints the neighboring
	// valid background ring; both are baked in upstream of fill (valid
	// alpha) with background-consistent depth, so a depth gate cannot
	// catch them and only refilling from interior background cures it.
	// The color gate preserves minification cracks and screen edges
	// (neighbors identical) exactly, and the 1px refilled ring doubles
	// as an edge blend. Identity frames have no holes, so they are
	// unaffected.
	if (!hole && pc.fillMode == 1) {
		uint ownEnc = imageLoad(splatDepth, xy).x;
		if (ownEnc != SPLAT_EMPTY) {
			bool nextToHole = false;
			ivec2 nxy = clamp(xy + ivec2(1, 0), ivec2(0), size - ivec2(1));
			if (imageLoad(splatDepth, nxy).x == SPLAT_EMPTY)
				nextToHole = true;
			nxy = clamp(xy + ivec2(-1, 0), ivec2(0), size - ivec2(1));
			if (imageLoad(splatDepth, nxy).x == SPLAT_EMPTY)
				nextToHole = true;
			nxy = clamp(xy + ivec2(0, 1), ivec2(0), size - ivec2(1));
			if (imageLoad(splatDepth, nxy).x == SPLAT_EMPTY)
				nextToHole = true;
			nxy = clamp(xy + ivec2(0, -1), ivec2(0), size - ivec2(1));
			if (imageLoad(splatDepth, nxy).x == SPLAT_EMPTY)
				nextToHole = true;
			if (nextToHole) {
				// Color gate: compare against valid neighbors only.
				// No valid neighbors (isolated speck) or a genuine
				// discontinuity means refilling; identical
				// surroundings mean the pixel is trustworthy.
				vec3 ownC = v.rgb / max(v.a, VALID_EPS);
				float cmax = 0.0;
				int nvalid = 0;
				vec4 t0 = imageLoad(srcImg, clamp(xy + ivec2(1, 0), ivec2(0),
				                                 size - ivec2(1)));
				if (t0.a >= VALID_EPS) {
					nvalid++;
					vec3 dd = abs(t0.rgb / t0.a - ownC);
					cmax = max(cmax, max(dd.r, max(dd.g, dd.b)));
				}
				t0 = imageLoad(srcImg, clamp(xy + ivec2(-1, 0), ivec2(0),
				                             size - ivec2(1)));
				if (t0.a >= VALID_EPS) {
					nvalid++;
					vec3 dd = abs(t0.rgb / t0.a - ownC);
					cmax = max(cmax, max(dd.r, max(dd.g, dd.b)));
				}
				t0 = imageLoad(srcImg, clamp(xy + ivec2(0, 1), ivec2(0),
				                             size - ivec2(1)));
				if (t0.a >= VALID_EPS) {
					nvalid++;
					vec3 dd = abs(t0.rgb / t0.a - ownC);
					cmax = max(cmax, max(dd.r, max(dd.g, dd.b)));
				}
				t0 = imageLoad(srcImg, clamp(xy + ivec2(0, -1), ivec2(0),
				                             size - ivec2(1)));
				if (t0.a >= VALID_EPS) {
					nvalid++;
					vec3 dd = abs(t0.rgb / t0.a - ownC);
					cmax = max(cmax, max(dd.r, max(dd.g, dd.b)));
				}
				if (nvalid == 0 || cmax > DILATE_COLOR_TOL)
					hole = true;
			}
		}
	}
	if (!hole) {
		imageStore(dstImg, xy, vec4(v.rgb / v.a, 1.0));
		return;
	}
	// Hole: mode 0 (and unknown modes) leave black.
	if (pc.fillMode != 1) {
		imageStore(dstImg, xy, vec4(0.0));
		return;
	}

	uint pack = imageLoad(jfaSeed, xy).x;
	if (pack == PACK_EMPTY) {
		imageStore(dstImg, xy, vec4(0.0));
		return;
	}
	ivec2 donor = ivec2(int(pack >> 16), int(pack & 0xffffu));
	if (donor.x < 0 || donor.y < 0 || donor.x >= size.x || donor.y >= size.y) {
		imageStore(dstImg, xy, vec4(0.0));
		return;
	}
	uint donorEnc = imageLoad(splatDepth, donor).x;
	if (donorEnc == SPLAT_EMPTY) {
		imageStore(dstImg, xy, vec4(0.0));
		return;
	}
	float donorDepth = float(donorEnc) / DEPTH_SCALE;

	// Function-scope accumulators (lavapipe reads back block-scope
	// loop-carried initializers stale; see warp_pull.comp note).
	vec3 sum = vec3(0.0);
	float wsum = 0.0;
	for (int oy = -2; oy <= 2; oy++) {
		for (int ox = -2; ox <= 2; ox++) {
			ivec2 sxy = clamp(donor + ivec2(ox, oy), ivec2(0), size - ivec2(1));
			uint e = imageLoad(splatDepth, sxy).x;
			if (e != SPLAT_EMPTY) {
				float d = float(e) / DEPTH_SCALE;
				if (d >= donorDepth - DEPTH_TOL) {
					// Erosion: the tap's 4-neighbors must all be
					// background too. Background edge pixels carry
					// bilinear pull fringe (foreground mixed into a
					// background-depth texel), so averaging them
					// drags foreground into the hole. Interior taps
					// have clean color. Clamped at image borders.
					bool interior = true;
					ivec2 nxy = clamp(sxy + ivec2(1, 0), ivec2(0), size - ivec2(1));
					uint ne = imageLoad(splatDepth, nxy).x;
					if (ne == SPLAT_EMPTY || float(ne) / DEPTH_SCALE < donorDepth - DEPTH_TOL)
						interior = false;
					nxy = clamp(sxy + ivec2(-1, 0), ivec2(0), size - ivec2(1));
					ne = imageLoad(splatDepth, nxy).x;
					if (ne == SPLAT_EMPTY || float(ne) / DEPTH_SCALE < donorDepth - DEPTH_TOL)
						interior = false;
					nxy = clamp(sxy + ivec2(0, 1), ivec2(0), size - ivec2(1));
					ne = imageLoad(splatDepth, nxy).x;
					if (ne == SPLAT_EMPTY || float(ne) / DEPTH_SCALE < donorDepth - DEPTH_TOL)
						interior = false;
					nxy = clamp(sxy + ivec2(0, -1), ivec2(0), size - ivec2(1));
					ne = imageLoad(splatDepth, nxy).x;
					if (ne == SPLAT_EMPTY || float(ne) / DEPTH_SCALE < donorDepth - DEPTH_TOL)
						interior = false;
					if (interior) {
						vec4 t = imageLoad(srcImg, sxy);
						if (t.a >= VALID_EPS) {
							sum += t.rgb / t.a;
							wsum += 1.0;
						}
					}
				}
			}
		}
	}
	if (wsum < 0.5) {
		// Starvation fallback (narrow background gaps where erosion
		// rejects every tap): retry un-eroded but still depth-gated so
		// foreground never leaks, then the donor texel itself, and only
		// then black. Black speckles inside filled bands are far more
		// visible than a slight fringe tint.
		for (int oy = -2; oy <= 2; oy++) {
			for (int ox = -2; ox <= 2; ox++) {
				ivec2 sxy = clamp(donor + ivec2(ox, oy), ivec2(0), size - ivec2(1));
				uint e = imageLoad(splatDepth, sxy).x;
				if (e != SPLAT_EMPTY) {
					float d = float(e) / DEPTH_SCALE;
					if (d >= donorDepth - DEPTH_TOL) {
						vec4 t = imageLoad(srcImg, sxy);
						if (t.a >= VALID_EPS) {
							sum += t.rgb / t.a;
							wsum += 1.0;
						}
					}
				}
			}
		}
	}
	if (wsum < 0.5) {
		vec4 dt = imageLoad(srcImg, donor);
		if (dt.a >= VALID_EPS) {
			imageStore(dstImg, xy, vec4(dt.rgb / dt.a, 1.0));
			return;
		}
		imageStore(dstImg, xy, vec4(0.0));
		return;
	}
	imageStore(dstImg, xy, vec4(sum / wsum, 1.0));
}
