/*
 * Openwarp Vulkan compute warp, pass 2 (pull).
 *
 * Part of the Openwarp project, NCSA licensed (see LICENSE).
 *
 * One thread per target pixel: read the splatted foreground depth,
 * unproject with the target inverses and reproject with the source
 * projection, then tap the retained color. Output is PREMULTIPLIED:
 * valid pixels store (rgb, 1), disoccluded pixels (0,0,0,0) (black
 * holes; the fill pass keeps them black).
 *
 * Warp math follows the OpenWarp family
 * (https://github.com/Zee2/openwarp, NCSA-licensed).
 */

#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D srcColor;

layout(set = 0, binding = 1) uniform PullUBO
{
	mat4 dstInv; // target clip -> world (inverse view * inverse projection, folded on CPU)
	mat4 srcVP; // source projection * source view, folded on CPU
} ubo;

layout(set = 0, binding = 2, r32ui) uniform uimage2D splatDepth;

layout(set = 0, binding = 3, rgba8) uniform writeonly image2D dstColor;

#define DEPTH_SCALE 16777215.0
#define SPLAT_EMPTY 0xffffffffu

// Reproject a target pixel (tuv in 0..1, standard depth z) back to a
// source UV. Returns false when the point is behind the source camera.
bool sourceUV(vec2 tuv, float z, out vec2 suv)
{
	vec4 clip = vec4(tuv * 2.0 - 1.0, z * 2.0 - 1.0, 1.0);
	vec4 world = ubo.dstInv * clip;
	vec4 srcClip = ubo.srcVP * world;
	if (srcClip.w <= 0.0)
		return false;
	suv = (srcClip.xy / srcClip.w) * 0.5 + 0.5;
	return true;
}

bool inBounds(vec2 uv)
{
	return uv.x >= 0.0 && uv.x <= 1.0 && uv.y >= 0.0 && uv.y <= 1.0;
}

void main()
{
	ivec2 dstXY = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(dstColor);
	if (dstXY.x >= size.x || dstXY.y >= size.y)
		return;
	vec2 tuv = (vec2(dstXY) + vec2(0.5)) / vec2(size);

	uint enc = imageLoad(splatDepth, dstXY).x;
	if (enc == SPLAT_EMPTY) {
		imageStore(dstColor, dstXY, vec4(0.0));
		return;
	}
	float depth = float(enc) / DEPTH_SCALE;
	vec2 suv = vec2(0.0);
	if (!sourceUV(tuv, depth, suv) || !inBounds(suv)) {
		imageStore(dstColor, dstXY, vec4(0.0));
		return;
	}

	// Explicit (zero) gradients: implicit-derivative texture() in
	// compute is undefined for non-uniform UVs (seams at depth
	// discontinuities); lod 0 keeps the linear filtering.
	vec4 color = textureGrad(srcColor, suv, vec2(0.0), vec2(0.0));
	imageStore(dstColor, dstXY, vec4(color.rgb, 1.0));
}
