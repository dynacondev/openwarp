/*
 * Openwarp Vulkan compute warp, pass 2 (pull).
 *
 * Part of the Openwarp project, NCSA licensed (see LICENSE).
 *
 * One thread per target pixel: read the splatted foreground depth,
 * unproject with the target inverses and reproject with the source
 * projection, then tap the retained color with a depth-consistent 2x2
 * gather (bilinear weights, but only taps whose source depth matches
 * the reprojected depth contribute). Plain bilinear blends across
 * source silhouettes, leaving a gray fringe column on every edge that
 * reads as foreground drag in motion; gating taps on depth keeps
 * edges exact while preserving filtering on smooth surfaces. Output is
 * PREMULTIPLIED: valid pixels store (rgb, 1), disoccluded pixels
 * (0,0,0,0) (black holes; the fill pass keeps them black).
 *
 * Warp math follows the OpenWarp family
 * (https://github.com/Zee2/openwarp, NCSA-licensed).
 */

#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D srcColor;

// Source depth for the consistency gate (standard 0..1 nonlinear,
// same convention as the splat plane contents after unprojection).
layout(set = 0, binding = 4) uniform sampler2D srcDepth;

layout(set = 0, binding = 1) uniform PullUBO
{
	mat4 dstInv; // target clip -> world (inverse view * inverse projection, folded on CPU)
	mat4 srcVP; // source projection * source view, folded on CPU
} ubo;

layout(set = 0, binding = 2, r32ui) uniform uimage2D splatDepth;

layout(set = 0, binding = 3, rgba8) uniform writeonly image2D dstColor;

#define DEPTH_SCALE 16777215.0
#define SPLAT_EMPTY 0xffffffffu
// Source-depth consistency width, nonlinear 0..1 units (same scale as
// the fill's DEPTH_TOL): taps this far from the reprojected depth are
// across a silhouette and must not blend in.
#define PULL_DEPTH_TOL 0.02

// Reproject a target pixel (tuv in 0..1, standard depth z) back to a
// source UV plus the expected source depth there. Returns false when
// the point is behind the source camera.
bool sourceUV(vec2 tuv, float z, out vec2 suv, out float ez)
{
	vec4 clip = vec4(tuv * 2.0 - 1.0, z * 2.0 - 1.0, 1.0);
	vec4 world = ubo.dstInv * clip;
	vec4 srcClip = ubo.srcVP * world;
	if (srcClip.w <= 0.0)
		return false;
	suv = (srcClip.xy / srcClip.w) * 0.5 + 0.5;
	ez = srcClip.z / srcClip.w * 0.5 + 0.5;
	return true;
}

bool inBounds(vec2 uv)
{
	return uv.x >= 0.0 && uv.x <= 1.0 && uv.y >= 0.0 && uv.y <= 1.0;
}

void main()
{
	ivec2 dstXY = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(dstColor);
	if (dstXY.x >= size.x || dstXY.y >= size.y)
		return;
	vec2 tuv = (vec2(dstXY) + vec2(0.5)) / vec2(size);

	uint enc = imageLoad(splatDepth, dstXY).x;
	if (enc == SPLAT_EMPTY) {
		imageStore(dstColor, dstXY, vec4(0.0));
		return;
	}
	float depth = float(enc) / DEPTH_SCALE;
	vec2 suv = vec2(0.0);
	float ez = 0.0;
	if (!sourceUV(tuv, depth, suv, ez) || !inBounds(suv)) {
		imageStore(dstColor, dstXY, vec4(0.0));
		return;
	}

	// Depth-consistent 2x2 gather with bilinear weights: texelFetch
	// gives exact taps (sampler filtering would blend across the edge
	// before we can gate). Taps are clamped like CLAMP_TO_EDGE.
	// Function-scope accumulators (lavapipe reads back block-scope
	// loop-carried initializers stale; see the note in warp_fill).
	ivec2 tsize = textureSize(srcColor, 0);
	vec2 p = suv * vec2(tsize) - vec2(0.5);
	vec2 f = fract(p);
	ivec2 b = ivec2(floor(p));
	vec3 sum = vec3(0.0);
	float wsum = 0.0;
	for (int oy = 0; oy <= 1; oy++) {
		for (int ox = 0; ox <= 1; ox++) {
			ivec2 txy = clamp(b + ivec2(ox, oy), ivec2(0), tsize - ivec2(1));
			float tz = texelFetch(srcDepth, txy, 0).x;
			if (abs(tz - ez) < PULL_DEPTH_TOL) {
				vec4 c = texelFetch(srcColor, txy, 0);
				float w = (ox == 0 ? 1.0 - f.x : f.x) * (oy == 0 ? 1.0 - f.y : f.y);
				sum += c.rgb * w;
				wsum += w;
			}
		}
	}
	if (wsum <= 1e-6) {
		imageStore(dstColor, dstXY, vec4(0.0));
		return;
	}
	imageStore(dstColor, dstXY, vec4(sum / wsum, 1.0));
}
