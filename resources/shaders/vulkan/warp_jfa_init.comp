/*
 * Openwarp Vulkan compute warp, JFA seed init (background-only seeds).
 *
 * Part of the Openwarp project, NCSA licensed (see LICENSE).
 *
 * One thread per target pixel: classify splatDepth texels into
 * background seeds vs holes/foreground. Seeds pack their own coords
 * as (x << 16) | y; everything else is PACK_EMPTY and never
 * propagates. Only background propagates, so the later flood + blur
 * can only fill from background (never smear foreground across an
 * edge).
 *
 * A seed is background when its own depth is within DEPTH_TOL of the
 * deepest valid splat in a 5x5 window around itself. The window only
 * produces one scalar threshold per pixel (never color), so it cannot
 * paint blocky color edges; color stays full-res in the fill pass.
 * Keep DEPTH_TOL in sync with warp_fill.comp (same value, seed
 * classification vs gather gating).
 */

#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, r32ui) uniform readonly uimage2D splatDepth;
layout(set = 0, binding = 1, r32ui) uniform writeonly uimage2D jfaDst;

#define SPLAT_EMPTY 0xffffffffu
#define PACK_EMPTY 0xffffffffu
#define DEPTH_SCALE 16777215.0
#define DEPTH_TOL 0.02

uint packCoord(ivec2 p)
{
	return (uint(p.x) << 16) | uint(p.y);
}

void main()
{
	ivec2 xy = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(jfaDst);
	if (xy.x >= size.x || xy.y >= size.y)
		return;

	uint enc = imageLoad(splatDepth, xy).x;
	if (enc == SPLAT_EMPTY) {
		imageStore(jfaDst, xy, uvec4(PACK_EMPTY));
		return;
	}
	float depth = float(enc) / DEPTH_SCALE;

	// Function-scope accumulator (lavapipe reads back block-scope
	// loop-carried initializers stale; see warp_pull.comp note).
	float bgDepth = depth;
	for (int oy = -2; oy <= 2; oy++) {
		for (int ox = -2; ox <= 2; ox++) {
			ivec2 sxy = clamp(xy + ivec2(ox, oy), ivec2(0), size - ivec2(1));
			uint e = imageLoad(splatDepth, sxy).x;
			if (e != SPLAT_EMPTY) {
				float d = float(e) / DEPTH_SCALE;
				if (d > bgDepth)
					bgDepth = d;
			}
		}
	}

	if (depth >= bgDepth - DEPTH_TOL)
		imageStore(jfaDst, xy, uvec4(packCoord(xy)));
	else
		imageStore(jfaDst, xy, uvec4(PACK_EMPTY));
}
