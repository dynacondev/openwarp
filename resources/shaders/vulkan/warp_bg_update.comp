/*
 * Openwarp Vulkan compute warp, pass 5 (temporal BG cache).
 *
 * Part of the Openwarp project, NCSA licensed (see LICENSE).
 *
 * Persistent half-res background layer that sits UNDERNEATH every fill
 * mode (0..4): the host dispatches this pass after pull and before the
 * mip blits / fill, so cached texels reach the fill input and every
 * mode branch treats them as ordinary valid pixels. The fill pass
 * itself is untouched (its set/push layout is shared with the fill1
 * agent — no collision by construction).
 *
 * mode 1 (update, half-res threads): downsample this frame's valid
 * pull pixels (splat != EMPTY, premultiplied alpha >= eps) 2x2 into
 * bgColor/bgDepth. Holes keep their previous texels (amortized
 * persistence). Runs only on static frames (host-gated: intra-warp
 * src/dst delta < 2mm / 0.3deg); a fresh Upload clears bgDepth to
 * BG_INVALID and the host skips projection until primed.
 *
 * mode 0 (project/apply, full-res threads): holes (alpha < eps) sample
 * bgColor/bgDepth at the hole UV. Reuse requires a cached depth
 * (bgDepth >= 0) AND a flat neighborhood (|Zbg - neighborBgDepth| <
 * BG_TOL on all 4 half-res neighbors); on pass the bilinear-gathered
 * bg texel is stored straight with w = 1, so the fill normalize turns
 * it into an exact copy and it never smears. On fail the hole keeps
 * black and falls through to the mode branches.
 *
 * World motion is a host-side stub (pose deltas in vulkan_warp.cpp,
 * tune.z = enabled / tune.w = static for observability); full
 * per-pixel GFFE history is follow-up work.
 */

#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// Full-res pull output (premultiplied (rgb*w, w), holes (0,0,0,0)).
layout(set = 0, binding = 0, rgba8) uniform image2D dstImg;
// Full-res target-view depth encodings (validity + depth source).
layout(set = 0, binding = 1, r32ui) uniform uimage2D splatDepth;
// Persistent half-res background (GENERAL, host-cleared on Upload).
layout(set = 0, binding = 2, rgba8) uniform image2D bgColor;
layout(set = 0, binding = 3, r32f) uniform image2D bgDepth;

layout(push_constant) uniform Push
{
	int mode; // 0 = project/apply, 1 = update
} pc;

#define SPLAT_EMPTY 0xffffffffu
#define VALID_EPS (0.5 / 255.0)
#define DEPTH_SCALE 16777215.0
// bgDepth < 0 means "no cached texel" (host clears to -1 on Upload).
#define BG_INVALID -1.0
// Depth-consistency gate for reuse, in nonlinear 0..1 depth units.
#define BG_TOL 0.05

// Manual bilinear gather (storage images have no sampler).
vec3 bgBilinear(vec2 uv)
{
	ivec2 bs = imageSize(bgColor);
	vec2 p = uv * vec2(bs) - vec2(0.5);
	ivec2 i0 = ivec2(floor(p));
	vec2 f = clamp(p - vec2(i0), vec2(0.0), vec2(1.0));
	i0 = clamp(i0, ivec2(0), bs - ivec2(1));
	ivec2 i1 = min(i0 + ivec2(1), bs - ivec2(1));
	vec3 c00 = imageLoad(bgColor, ivec2(i0.x, i0.y)).rgb;
	vec3 c10 = imageLoad(bgColor, ivec2(i1.x, i0.y)).rgb;
	vec3 c01 = imageLoad(bgColor, ivec2(i0.x, i1.y)).rgb;
	vec3 c11 = imageLoad(bgColor, ivec2(i1.x, i1.y)).rgb;
	return mix(mix(c00, c10, f.x), mix(c01, c11, f.x), f.y);
}

void main()
{
	// Structured ifs only (no continue/break): matches the pull/fill
	// convention for lavapipe loop-carried state.
	if (pc.mode == 1) {
		// Update: one thread per half-res bg texel.
		ivec2 bxy = ivec2(gl_GlobalInvocationID.xy);
		ivec2 bs = imageSize(bgColor);
		if (bxy.x < bs.x && bxy.y < bs.y) {
			ivec2 fs = imageSize(dstImg);
			vec3 sum = vec3(0.0);
			float dsum = 0.0;
			int n = 0;
			for (int oy = 0; oy < 2; oy++) {
				for (int ox = 0; ox < 2; ox++) {
					ivec2 fxy = bxy * ivec2(2) + ivec2(ox, oy);
					if (fxy.x < fs.x && fxy.y < fs.y) {
						uint e = imageLoad(splatDepth, fxy).x;
						if (e != SPLAT_EMPTY) {
							vec4 v = imageLoad(dstImg, fxy);
							if (v.a >= VALID_EPS) {
								sum += v.rgb / max(v.a, 1e-6);
								dsum += float(e) / DEPTH_SCALE;
								n++;
							}
						}
					}
				}
			}
			if (n > 0) {
				imageStore(bgColor, bxy, vec4(sum / float(n), 1.0));
				imageStore(bgDepth, bxy, vec4(dsum / float(n)));
			}
			// n == 0: keep the previous texel (amortized).
		}
		return;
	}

	// Project/apply: one thread per full-res pixel.
	ivec2 xy = ivec2(gl_GlobalInvocationID.xy);
	ivec2 fs = imageSize(dstImg);
	if (xy.x >= fs.x || xy.y >= fs.y)
		return;
	vec4 v = imageLoad(dstImg, xy);
	if (v.a >= VALID_EPS)
		return; // valid: the fill normalize owns this pixel
	vec2 uv = (vec2(xy) + vec2(0.5)) / vec2(fs);
	ivec2 bs = imageSize(bgColor);
	ivec2 bc = clamp(ivec2(uv * vec2(bs)), ivec2(0), bs - ivec2(1));
	float d0 = imageLoad(bgDepth, bc).x;
	if (d0 < 0.0)
		return; // nothing cached here yet
	// Flat-neighborhood gate: reject depth edges so a stale texel
	// never smears across a discontinuity.
	ivec2 bLo = ivec2(0);
	ivec2 bHi = bs - ivec2(1);
	float dL = imageLoad(bgDepth, clamp(bc + ivec2(-1, 0), bLo, bHi)).x;
	float dR = imageLoad(bgDepth, clamp(bc + ivec2(1, 0), bLo, bHi)).x;
	float dU = imageLoad(bgDepth, clamp(bc + ivec2(0, -1), bLo, bHi)).x;
	float dD = imageLoad(bgDepth, clamp(bc + ivec2(0, 1), bLo, bHi)).x;
	if (abs(dL - d0) >= BG_TOL)
		return;
	if (abs(dR - d0) >= BG_TOL)
		return;
	if (abs(dU - d0) >= BG_TOL)
		return;
	if (abs(dD - d0) >= BG_TOL)
		return;
	vec3 c = bgBilinear(uv);
	// Straight color with w = 1: the fill un-premultiply is a no-op
	// and every mode branch sees a valid pixel.
	imageStore(dstImg, xy, vec4(c, 1.0));
}
